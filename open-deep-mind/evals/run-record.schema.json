{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDeepMind Benchmark Run Record",
  "type": "object",
  "required": [
    "case_id",
    "configuration",
    "repetition",
    "model",
    "route",
    "loaded_modules",
    "response_text",
    "total_tokens",
    "duration_ms"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "string",
      "minLength": 1
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string"
    },
    "route": {
      "enum": [
        "phi",
        "p",
        "phi-p",
        "triz",
        "none",
        "unknown"
      ]
    },
    "loaded_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["first-philosophy", "first-principles", "triz"]
      }
    },
    "response_text": {
      "type": "string",
      "minLength": 1
    },
    "total_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "repository_commit": {
      "type": "string"
    },
    "run_timestamp": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
